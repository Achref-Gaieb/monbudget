# ---------------------------------------------------------------------------
# MonBudget — environment variables
#
# Copy this file to `.env.local` and fill in the values you need.
# `.env.local` is git-ignored: never commit real keys or secrets.
#
# v1.0.0 runs entirely in the browser (LocalStorage) and needs NO variable
# to work locally. Everything below is optional today and prepares the
# roadmap features (auth, cloud database, subscriptions, AI assistant).
# ---------------------------------------------------------------------------

# Public base URL of the deployment. Used for canonical URLs, Open Graph
# and social preview images. On Vercel, set it to your production domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Cloud storage (roadmap: cloud backup & multi-device sync) --------------
# Swap the LocalStorage adapter in lib/storage.ts for a remote backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Authentication (roadmap: user accounts) -------------------------------
AUTH_SECRET=
AUTH_URL=

# --- Subscriptions (roadmap: Premium plan) ---------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- AI assistant (roadmap: "Where does my money go?") ---------------------
# Server-side only — never expose a model API key with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# --- Analytics (optional) --------------------------------------------------
NEXT_PUBLIC_ANALYTICS_ID=
